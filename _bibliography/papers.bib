@inproceedings{aytekin2026docking,
  abbr        = {IAC},
  bibtex_show = {true},
  selected    = {true},
  title       = {Reinforcement Learning for Offset-Port Autonomous Docking with Coupled Rotational--Translational Dynamics in Low Earth Orbit},
  author      = {Aytekin, Onur and Waggoner, Kullen and Bagci, Murat and Avci, Aybar},
  booktitle   = {77th International Astronautical Congress (IAC)},
  address     = {Antalya, T{\"u}rkiye},
  month       = oct,
  year        = {2026},
  note        = {Oral presentation},
  abstract    = {Offset-port autonomous docking is formulated as a Markov decision process with fully coupled 6-DOF rotational--translational relative dynamics under J2 perturbations, capturing attitude--position coupling neglected by decoupled Clohessy--Wiltshire formulations. PPO agents trained in a custom Gymnasium environment dock with targets tumbling at up to 2.5 deg/s, beyond the roughly 1 deg/s limit of a classical PD guidance baseline, at a quantified fuel cost.}
}

@inproceedings{aytekin2026maneuver,
  abbr        = {NAECON},
  bibtex_show = {true},
  selected    = {true},
  title       = {Learning-Based Cooperative Maneuver Planning for Multi-Spacecraft Proximity Operations},
  author      = {Aytekin, Onur and Waggoner, Kullen and Ergin, N. E.},
  booktitle   = {IEEE National Aerospace \& Electronics Conference (NAECON)},
  address     = {Cincinnati, OH},
  month       = aug,
  year        = {2026},
  doi         = {10.1109/NAECON70028.2026.11674936},
  abstract    = {A MAPPO framework with centralized training and decentralized execution plans cooperative maneuvers for multi-spacecraft proximity operations under Hill--Clohessy--Wiltshire dynamics, benchmarked against an LQR plus artificial-potential-field baseline. A behavior-cloning warm start accelerates convergence, and results are validated with Wilson score intervals, McNemar tests, and bootstrap confidence intervals.}
}
